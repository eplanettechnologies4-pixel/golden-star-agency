# Django Configurations
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configurations
# Format: postgresql://username:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/golden_star_db

# Redis Configuration (Celery Broker & Backend)
REDIS_URL=redis://localhost:6379/0

# Security and Cryptography
# Generate via: cryptography.fernet.Fernet.generate_key().decode()
ENCRYPTION_KEY=your-32-byte-base64-encryption-key-here
JWT_SECRET_KEY=your-jwt-signing-key-here

# Third-party Integrations and AI
CLAUDE_API_KEY=your-anthropic-api-key-here
GROQ_API_KEY=your-groq-api-key-here
N8N_WEBHOOK_URL=http://localhost:5678/webhook/

# Environment indicator
ENVIRONMENT=development
